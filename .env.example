APP_ENV=development
DATABASE_URL=postgresql+psycopg://wellbeing:replace-with-local-password@127.0.0.1:55432/wellbeing
TEST_DATABASE_URL=postgresql+psycopg://wellbeing:replace-with-local-password@127.0.0.1:55432/wellbeing_test
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_HOST=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
ENABLE_DEV_AUTH=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
LLM_ENABLED=false
OPENAI_API_KEY=
# Explicit model supporting Responses structured outputs; no default or auto-upgrade.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
LLM_HOURLY_LIMIT=5
LLM_DAILY_LIMIT=20
# Set to the staged static directory only when serving a compiled release.
FRONTEND_DIST=
